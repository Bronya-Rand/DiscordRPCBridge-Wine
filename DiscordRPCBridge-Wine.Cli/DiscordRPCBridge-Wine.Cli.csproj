<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DiscordRPCBridge_Wine.Cli</RootNamespace>
    <AssemblyName>discord-rpc-bridge</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.0.1</Version>
    <Authors>Bronya Rand</Authors>
    <Description>Standalone Discord RPC Bridge server binary for Linux and macOS host systems.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiscordRPCBridge-Wine\DiscordRPCBridge-Wine.csproj" />
  </ItemGroup>

</Project>
